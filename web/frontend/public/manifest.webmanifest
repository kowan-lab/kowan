{
  "name": "Kowan",
  "short_name": "Kowan",
  "description": "Run and watch Docker workloads across your hosts.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f4f1ea",
  "theme_color": "#f4f1ea",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/favicon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Workloads", "url": "/workloads", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Logs", "url": "/logs", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Uptime", "url": "/uptime", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] }
  ]
}
