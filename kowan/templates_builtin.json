  {
    "id": "builtin:nginx",
    "name": "Nginx",
    "description": "High-performance web server and reverse proxy. Serves the default page until you mount content.",
    "category": "Web",
    "icon": "nginx",
    "website": "https://nginx.org",
    "type": "container",
    "inputs": [
      {
        "name": "HTTP_PORT",
        "label": "HTTP port",
        "default": "8080",
        "required": true
      }
    ],
    "spec": {
      "image": "nginx:stable-alpine",
      "env": [],
      "ports": [
        {
          "hostPort": "${HTTP_PORT}",
          "containerPort": 80,
          "protocol": "tcp"
        }
      ],
      "volumes": [
        {
          "source": "${KOWAN_NAME}-html",
          "target": "/usr/share/nginx/html",
          "readOnly": false
        }
      ],
      "networks": [],
      "restartPolicy": "unless-stopped",
      "command": [],
      "labels": {}
    }
  },
  {
    "id": "builtin:traefik",
    "name": "Traefik",
    "description": "Cloud-native reverse proxy that discovers containers through Docker labels. Dashboard on the API port.",
    "category": "Web",
    "icon": "traefik",
    "website": "https://traefik.io/traefik",
    "type": "container",
    "inputs": [
      {
        "name": "HTTP_PORT",
        "label": "HTTP port",
        "default": "80",
        "required": true
      },
      {
        "name": "DASHBOARD_PORT",
        "label": "Dashboard port",
        "default": "8088",
        "required": true
      }
    ],
    "spec": {
      "image": "traefik:v3",
      "env": [],
      "ports": [
        {
          "hostPort": "${HTTP_PORT}",
          "containerPort": 80,
          "protocol": "tcp"
        },
        {
          "hostPort": "${DASHBOARD_PORT}",
          "containerPort": 8080,
          "protocol": "tcp"
        }
      ],
      "volumes": [
        {
          "source": "/var/run/docker.sock",
          "target": "/var/run/docker.sock",
          "readOnly": true
        }
      ],
      "networks": [],
      "restartPolicy": "unless-stopped",
      "command": [
        "--providers.docker=true",
        "--providers.docker.exposedbydefault=false",
        "--entrypoints.web.address=:80",
        "--api.dashboard=true",
        "--api.insecure=true"
      ],
      "labels": {}
    }
  },
