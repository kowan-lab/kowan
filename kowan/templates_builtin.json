  {
    "id": "builtin:pihole",
    "name": "Pi-hole",
    "description": "Network-wide ad blocking DNS server with a web admin UI.",
    "category": "Network",
    "icon": "pihole",
    "website": "https://pi-hole.net",
    "type": "compose",
    "inputs": [
      {
        "name": "DNS_PORT",
        "label": "DNS port",
        "default": "53",
        "required": true
      },
      {
        "name": "HTTP_PORT",
        "label": "Web UI port",
        "default": "8083",
        "required": true
      },
      {
        "name": "WEB_PASSWORD",
        "label": "Admin password",
        "required": true,
        "secret": true
      },
      {
        "name": "TZ",
        "label": "Time zone",
        "description": "IANA name, e.g. Europe/Rome",
        "default": "Etc/UTC"
      }
    ],
    "compose": "services:\n  pihole:\n    image: pihole/pihole:latest\n    restart: unless-stopped\n    ports:\n      - \"${DNS_PORT}:53/tcp\"\n      - \"${DNS_PORT}:53/udp\"\n      - \"${HTTP_PORT}:80/tcp\"\n    environment:\n      TZ: \"${TZ}\"\n      FTLCONF_webserver_api_password: \"${WEB_PASSWORD}\"\n      FTLCONF_dns_listeningMode: \"all\"\n    volumes:\n      - etc-pihole:/etc/pihole\nvolumes:\n  etc-pihole:\n"
  },
